From 6bd5a9b1b242aff51ef7b676ea1217eae5b60d5d Mon Sep 17 00:00:00 2001
From: Graeme Smecher <gsmecher@t0.technology>
Date: Sat, 14 Nov 2026 09:08:17 -0700
Subject: [PATCH 5/6] hw/microblaze/microblaze_generic_fdt: migrate the main
 memory

The microblaze-fdt machine's main memory isn't registered for migration,
so it comes back empty: the ZynqMP PMU's ROM, for one. Register it.

(For xilinx_v2026.1 only: on master, hwdtb creates this memory, and the
fix is there.)

Signed-off-by: Graeme Smecher <gsmecher@t0.technology>
---
 hw/microblaze/microblaze_generic_fdt.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/hw/microblaze/microblaze_generic_fdt.c b/hw/microblaze/microblaze_generic_fdt.c
index cc6e57948f..154cc97cde 100644
--- a/hw/microblaze/microblaze_generic_fdt.c
+++ b/hw/microblaze/microblaze_generic_fdt.c
@@ -191,6 +191,12 @@ microblaze_generic_fdt_init(MachineState *machine)
     fdti = fdt_generic_create_machine(fdt, NULL);
     main_mem = MEMORY_REGION(object_resolve_path(node_path, NULL));
 
+    /* Nothing else registers the main memory for migration */
+    if (memory_region_is_ram(main_mem) &&
+        !qemu_ram_is_migratable(main_mem->ram_block)) {
+        vmstate_register_ram_global(main_mem);
+    }
+
     ram_kernel_base = object_property_get_int(OBJECT(main_mem), "addr", NULL);
     ram_kernel_size = object_property_get_int(OBJECT(main_mem), "size", NULL);
 
