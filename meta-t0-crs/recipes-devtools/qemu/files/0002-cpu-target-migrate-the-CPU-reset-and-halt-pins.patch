From eb3ccddfd317fcebfc2735cb295b73851a653967 Mon Sep 17 00:00:00 2001
From: Graeme Smecher <gsmecher@t0.technology>
Date: Sat, 14 Nov 2026 09:04:50 -0700
Subject: [PATCH 2/6] cpu-target: migrate the CPU reset and halt pins

The destination's reset can assert a CPU's reset pin (ZynqMP's CRF does),
and nothing lowers it once the state is loaded: CPUs that were halted
when the state was saved never wake.

The subsection is always sent, so for every target, streams no longer
load on a QEMU without this change.

Signed-off-by: Graeme Smecher <gsmecher@t0.technology>
---
 cpu-target.c | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/cpu-target.c b/cpu-target.c
index 5a5c57511b..52500f553b 100644
--- a/cpu-target.c
+++ b/cpu-target.c
@@ -112,6 +112,19 @@ static const VMStateDescription vmstate_cpu_common_crash_occurred = {
     }
 };
 
+/* Always sent: the destination's reset may have set a pin */
+static const VMStateDescription vmstate_cpu_common_pins = {
+    .name = "cpu_common/pins",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (VMStateField[]) {
+        VMSTATE_BOOL(reset_pin, CPUState),
+        VMSTATE_BOOL(halt_pin, CPUState),
+        VMSTATE_BOOL(arch_halt_pin, CPUState),
+        VMSTATE_END_OF_LIST()
+    }
+};
+
 const VMStateDescription vmstate_cpu_common = {
     .name = "cpu_common",
     .version_id = 1,
@@ -126,6 +139,7 @@ const VMStateDescription vmstate_cpu_common = {
     .subsections = (const VMStateDescription*[]) {
         &vmstate_cpu_common_exception_index,
         &vmstate_cpu_common_crash_occurred,
+        &vmstate_cpu_common_pins,
         NULL
     }
 };
