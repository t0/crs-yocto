From f3624142ea356eabce6f0725d3b045fc07007827 Mon Sep 17 00:00:00 2001
From: Graeme Smecher <gsmecher@t0.technology>
Date: Sat, 14 Nov 2026 09:04:50 -0700
Subject: [PATCH 3/6] target/microblaze: migrate the CPU's registers

vmstate_mb_cpu is version 0 but its env field is tagged version 1, so
the registers were never saved or loaded. Make the description version
1, with a minimum of 1: older streams carry no registers.

Also save env->wakeup, the levels of the wakeup lines.

Fixes: 77f63e1dadb3 ("target/microblaze: Fill in VMStateDescription for cpu")
Signed-off-by: Graeme Smecher <gsmecher@t0.technology>
---
 target/microblaze/machine.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/target/microblaze/machine.c b/target/microblaze/machine.c
index d24def3992..c5eb947c5d 100644
--- a/target/microblaze/machine.c
+++ b/target/microblaze/machine.c
@@ -76,6 +76,7 @@ static VMStateField vmstate_env_fields[] = {
     VMSTATE_UINT32(btarget, CPUMBState),
     VMSTATE_UINT32(imm, CPUMBState),
     VMSTATE_UINT32(iflags, CPUMBState),
+    VMSTATE_UINT32(wakeup, CPUMBState),
 
     VMSTATE_UINT32(res_val, CPUMBState),
     VMSTATE_UINTTL(res_addr, CPUMBState),
@@ -100,7 +101,7 @@ static VMStateField vmstate_cpu_fields[] = {
 
 const VMStateDescription vmstate_mb_cpu = {
     .name = "cpu",
-    .version_id = 0,
-    .minimum_version_id = 0,
+    .version_id = 1,
+    .minimum_version_id = 1,
     .fields = vmstate_cpu_fields,
 };
